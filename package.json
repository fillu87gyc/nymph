{
  "name": "nymph",
  "version": "0.1.0",
  "description": "Markdown review tool with hot reload and inline commenting",
  "type": "module",
  "bin": {
    "nymph": "src/cli.ts"
  },
  "scripts": {
    "dev": "NYMPH_NO_OPEN=1 concurrently -k -n server,vite -c cyan,magenta \"bun --watch src/cli.ts $NYMPH_FILES\" \"vite --open\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:vrt": "playwright test --config playwright.vrt.config.ts",
    "lint": "biome check --diagnostic-level=error src/ tests/",
    "fmt": "biome format --write src/ tests/",
    "fmt:check": "biome format --diagnostic-level=error src/ tests/"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.7",
    "open": "^11.0.0",
    "swr": "^2.4.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bun": "^1.3.14",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6",
    "@vitest/coverage-v8": "4",
    "concurrently": "^10.0.0",
    "highlight.js": "^11.9.0",
    "jsdom": "^29.0.0",
    "marked": "^18.0.0",
    "mermaid": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.0",
    "vite": "8",
    "vitest": "4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "files": [
    "dist",
    "src/cli.ts",
    "src/server.ts",
    "src/client"
  ]
}
