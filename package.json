{
  "name": "nymph",
  "version": "0.1.0",
  "description": "Markdown review tool with hot reload and inline commenting",
  "type": "module",
  "bin": {
    "nymph": "src/cli.ts"
  },
  "scripts": {
    "dev": "NYMPH_NO_OPEN=1 concurrently -k -n server,vite -c cyan,magenta \"bun --watch src/cli.ts $NYMPH_FILES\" \"vite --open\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "lint": "biome check --diagnostic-level=error src/ tests/",
    "fmt": "biome format --write src/ tests/",
    "fmt:check": "biome format --diagnostic-level=error src/ tests/"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "open": "^10.1.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bun": "^1.3.14",
    "@types/diff": "^5.2.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5",
    "@vitest/coverage-v8": "3",
    "concurrently": "^9.0.0",
    "highlight.js": "^11.9.0",
    "jsdom": "^25.0.0",
    "marked": "^9.0.0",
    "mermaid": "^10.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.6.0",
    "vite": "7",
    "vitest": "3"
  },
  "files": ["dist", "src/cli.ts", "src/server.ts", "src/client"]
}
