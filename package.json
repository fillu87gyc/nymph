{
  "name": "nymph",
  "version": "0.1.0",
  "description": "Markdown review tool with hot reload and inline commenting",
  "type": "module",
  "bin": {
    "nymph": "src/cli.ts"
  },
  "scripts": {
    "dev": "NYMPH_NO_OPEN=1 concurrently -k -n server,vite -c cyan,magenta \"bun --watch src/cli.ts\" \"vite --open\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/diff": "^5.2.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "highlight.js": "^11.9.0",
    "jsdom": "^25.0.0",
    "marked": "^9.0.0",
    "mermaid": "^10.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist", "src/cli.ts", "src/server.ts", "src/client"]
}
